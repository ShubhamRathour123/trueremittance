# PostgreSQL connection string. Production uses Neon PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Internal admin password for /admin/login. Use a long random value in production.
ADMIN_SECRET="replace-with-a-long-random-admin-password"

# Secret used to sign admin session cookies. Use at least 32 random characters.
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
