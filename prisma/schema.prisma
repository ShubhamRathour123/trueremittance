generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryMethod {
  bank_transfer
  cash_pickup
  wallet
}

enum PaymentMethod {
  bank_transfer
  debit_card
  cash
}

enum QuoteSourceType {
  MANUAL
  API
  SCRAPER
  PARTNER_FEED
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  MANUAL_REVIEWED
  PROVIDER_QUOTE
  FAILED
}

model Provider {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  websiteUrl   String?
  affiliateUrl String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  rateQuotes   RateQuote[]
  clicks       AffiliateClick[]
}

model Corridor {
  id              String      @id @default(cuid())
  sourceCountry   String
  sourceCurrency  String
  targetCountry   String
  targetCurrency  String
  slug            String      @unique
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  rateQuotes      RateQuote[]
}

model RateQuote {
  id                 String             @id @default(cuid())
  providerId         String
  corridorId         String
  sendAmount         Decimal?           @db.Decimal(12, 4)
  sendCurrency       String             @default("AED")
  receiveCurrency    String             @default("INR")
  baseFee            Decimal            @db.Decimal(12, 4)
  feeCurrency        String             @default("AED")
  exchangeRate       Decimal            @db.Decimal(18, 8)
  midMarketRate      Decimal?           @db.Decimal(18, 8)
  deliveryMethod     DeliveryMethod
  paymentMethod      PaymentMethod
  deliverySpeed      String?
  sourceType         QuoteSourceType    @default(MANUAL)
  sourceReference    String?
  verificationStatus VerificationStatus @default(MANUAL_REVIEWED)
  isPromotional      Boolean            @default(false)
  promotionExpiresAt DateTime?
  minimumAmount      Decimal?           @db.Decimal(12, 4)
  maximumAmount      Decimal?           @db.Decimal(12, 4)
  notes              String?
  statusMessage      String?
  metadata           Json?
  fetchedAt          DateTime?
  timestamp          DateTime           @default(now())
  createdAt          DateTime           @default(now())
  provider           Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  corridor           Corridor           @relation(fields: [corridorId], references: [id], onDelete: Cascade)

  @@index([corridorId, providerId, timestamp])
  @@index([providerId, timestamp])
  @@index([corridorId, timestamp])
  @@index([sourceType, verificationStatus])
}

model AffiliateClick {
  id            String   @id @default(cuid())
  providerId    String
  corridorSlug  String?
  amountBucket  String?
  placement     String?
  ranking       Int?
  ctaType       String?
  destination   String
  clickedAt     DateTime @default(now())
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, clickedAt])
  @@index([corridorSlug, clickedAt])
}
